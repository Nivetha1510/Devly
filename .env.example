# Copy this file to .env.local and fill in the values from your Firebase project:
# Firebase console -> Project settings -> Your apps -> Web app -> SDK setup and configuration.
# Also enable Authentication -> Sign-in method -> Email/Password (and Google, for Google sign-in).
# Leave these empty to use on-device accounts instead (stored on this device only).
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
